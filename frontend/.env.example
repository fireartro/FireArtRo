# Production calls the API through the same public origin, so leave this empty
# on Vercel. It is optional only when local frontend and backend run separately.
REACT_APP_BACKEND_URL=
# These temporary local fallbacks are superseded by Admin-managed contact data
# after bootstrap. Do not put credentials, database URLs, Admin passwords,
# review-provider tokens, or BLOB_READ_WRITE_TOKEN in any REACT_APP_* value.
# Resend is configured only in the server/Vercel environment. Do not add any
# RESEND_* or email content variable to this frontend file.
REACT_APP_PHONE_DISPLAY=
REACT_APP_PHONE_TEL=
REACT_APP_WHATSAPP_NUMBER=
