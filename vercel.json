{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "installCommand": "npm ci && cd frontend && corepack yarn install --frozen-lockfile",
  "buildCommand": "cd frontend && corepack yarn build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/**",
      "excludeFiles": "{frontend/**,backend/tests/**,backend/.env,backend/.env.*,backend/.venv/**,.venv-cms/**,**/__pycache__/**}"
    },
    "api/admin/blob-upload.js": {
      "maxDuration": 60
    },
    "api/page.js": {
      "maxDuration": 30,
      "includeFiles": "{frontend/server-build/**,frontend/build/public-page-assets.json}"
    }
  },
