# Explicit local development connection; no runtime localhost fallback.
MONGODB_URI=mongodb://localhost:27017
# Temporary legacy alias. MONGODB_URI takes precedence when set.
# MONGO_URL=mongodb://localhost:27017
# Vercel Marketplace may inject MONGO_MONGODB_URI automatically; the server
# accepts it after MONGODB_URI and before the legacy MONGO_URL alias.
# Use distinct databases for Development, Preview, and Production.
DB_NAME=fireartro_development
ADMIN_USERNAME=admin
# Canonical bcrypt hash (cost 04-16); generate offline, never in REACT_APP_*.
ADMIN_PASSWORD_HASH=
# Independent random secret, at least 32 bytes; keep server-side only.
ADMIN_SESSION_SECRET=
# Missing/invalid Mongo or Admin settings leave /api/health at 503.
CORS_ORIGINS=http://localhost:3000,https://www.fireartro.ro
# CORS permits local preflight; Admin mutations still require same-origin + CSRF.
# Use the frontend dev proxy for Admin requests; production is same-origin.
# The legacy ADMIN_API_KEY is intentionally not used by this CMS.
# Vercel Blob credentials stay server-side. The origin is the single public
# hostname assigned to the connected Blob store, without a trailing slash.
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_MEDIA_ORIGIN=https://your-store.public.blob.vercel-storage.com
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Email stays fail-closed until every Resend setting below is present.
# Keep false in source and local examples; enable explicitly in Vercel only
# after the sending domain and signed webhook have both been verified.
RESEND_ENABLED=false
# Server-only Resend API key. Never expose it through REACT_APP_*.
RESEND_API_KEY=
# Signing secret for the exact /api/webhooks/resend endpoint in this environment.
RESEND_WEBHOOK_SECRET=
# These identities are fixed by the application and must match exactly.
RESEND_FROM_EMAIL=FireArtRo <contact@fireart.ro>
RESEND_NOTIFICATION_TO=fireartro@gmail.com
RESEND_INBOUND_DOMAIN=fireart.ro
RESEND_INBOUND_ADDRESS=contact@fireart.ro
